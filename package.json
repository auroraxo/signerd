  "description": "Refusal-first prototype: Unix-socket signing daemon, grant file, encrypted keystore. Not a reviewed wallet.",
  "main": "src/daemon.js",
  "bin": {
    "signerd": "bin/signerd.js"
  },
  "scripts": {
    "build": "cc -O2 -o tools/leasecheck tools/leasecheck.c",
