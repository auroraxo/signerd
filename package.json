  "bugs": {
    "url": "https://github.com/auroraxo/signerd/issues"
  },
  "homepage": "https://github.com/auroraxo/signerd#readme",
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "bs58": "4.0.1"
  }
}
